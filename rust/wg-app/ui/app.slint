import { Button, ComboBox, Slider, Switch, ScrollView, LineEdit, AboutSlint, Palette } from "std-widgets.slint";

export struct BindingRow { command: string, modifier: string, key: string }
export struct ThemeItem { name: string, line: color, start: color, end: color }

// ---------------------------------------------------------------------------------------
// Small building blocks
// ---------------------------------------------------------------------------------------

component Card inherits Rectangle {
    in property <string> title;
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        if root.title != "": Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            color: Palette.foreground;
        }
        @children
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    background: Palette.alternate-background;
    border-radius: 11px;
    border-width: 1px;
    border-color: Palette.border;
    height: 22px;
    min-width: 40px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text { text: root.text; font-size: 12px; color: Palette.foreground; vertical-alignment: center; }
    }
}

// A whole-number setting: label, [-] value [+] on one line and a slider underneath. The
// buttons make single steps easy; the slider covers big jumps. Both edit `value`.
component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <int> minimum: 1;
    in property <int> maximum: 32;
    in-out property <float> value;
    property <int> current: Math.round(root.value);

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.label; color: Palette.foreground; font-size: 14px; }
                if root.hint != "": Text { text: root.hint; color: Palette.foreground; opacity: 0.6; font-size: 12px; }
            }
            Button {
                text: "\u{2212}";
                width: 36px;
                accessible-label: "Fewer " + root.label;
                enabled: root.current > root.minimum;
                clicked => { root.value = Math.max(root.minimum, root.current - 1); }
            }
            Text {
                text: root.current;
                width: 34px;
                font-size: 18px;
                font-weight: 700;
                color: Palette.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Button {
                text: "+";
                width: 36px;
                accessible-label: "More " + root.label;
                enabled: root.current < root.maximum;
                clicked => { root.value = Math.min(root.maximum, root.current + 1); }
            }
        }
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: 1;
            value <=> root.value;
            changed(v) => { root.value = Math.round(v); }
        }
    }
}

// A short heading with a paragraph under it, for the technical page.
component Fact inherits Rectangle {
    in property <string> title;
    in property <string> body;
    VerticalLayout {
        spacing: 2px;
        Text { text: root.title; color: Palette.foreground; font-size: 13px; font-weight: 600; wrap: word-wrap; }
        Text { text: root.body; color: Palette.foreground; opacity: 0.72; font-size: 12px; wrap: word-wrap; }
    }
}

// One labelled setting: text on the left, the control on the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> dim: false;
    min-height: 34px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: Palette.foreground; opacity: root.dim ? 0.45 : 1.0; font-size: 14px; }
            if root.hint != "": Text { text: root.hint; color: Palette.foreground; opacity: 0.6; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: root.selected ? Palette.control-background : (touch.has-hover ? Palette.control-background.with-alpha(0.6) : transparent);
    // accent bar on the selected entry
    Rectangle {
        x: 0px;
        y: (root.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 18px : 0px;
        border-radius: 2px;
        background: Palette.accent-background;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        alignment: start;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
            font-weight: root.selected ? 600 : 400;
            font-size: 14px;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------------------------------
// Live preview: a monitor with the grid and a sample selection in the chosen theme
// ---------------------------------------------------------------------------------------

component GridPreview inherits Rectangle {
    in property <int> cols: 12;
    in property <int> rows: 6;
    in property <float> ratio: 1.7778;
    in property <color> line: #00bdd4;
    in property <color> start: #0097a7;
    in property <color> end: #b2ebf2;
    in property <bool> radial: true;
    in property <bool> fill: true;

    // Selection: roughly the middle half of the grid.
    property <int> c0: Math.floor(root.cols / 4);
    property <int> c1: Math.max(root.c0 + 1, Math.ceil(root.cols * 3 / 4));
    property <int> r0: Math.floor(root.rows / 4);
    property <int> r1: Math.max(root.r0 + 1, Math.ceil(root.rows * 3 / 4));

    background: #11161c;
    border-radius: 4px;
    border-width: 4px;
    border-color: #2b333c;
    clip: true;
    height: self.width / root.ratio;

    // Grid lines
    for i in Math.max(root.cols - 1, 0): Rectangle {
        x: root.width * (i + 1) / root.cols - 0.5px;
        width: 1px;
        height: root.height;
        background: root.line;
        opacity: 0.8;
    }
    for j in Math.max(root.rows - 1, 0): Rectangle {
        y: root.height * (j + 1) / root.rows - 0.5px;
        height: 1px;
        width: root.width;
        background: root.line;
        opacity: 0.8;
    }

    // Sample selection
    Rectangle {
        x: root.width * root.c0 / root.cols;
        y: root.height * root.r0 / root.rows;
        width: root.width * (root.c1 - root.c0) / root.cols;
        height: root.height * (root.r1 - root.r0) / root.rows;
        border-radius: 3px;
        border-width: 2px;
        border-color: root.line;
        background: !root.fill ? transparent : (root.radial
            ? @radial-gradient(circle, root.start.darker(0.35) 0%, root.start 100%)
            : @linear-gradient(135deg, root.start 0%, root.end 100%));
    }
}

// ---------------------------------------------------------------------------------------
// Settings window
// ---------------------------------------------------------------------------------------

// A page of the settings window: title, one-line description, then the content. It scrolls
// only when the window is made too small for it.
component Page inherits ScrollView {
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        padding: 24px;
        padding-top: 20px;
        spacing: 14px;
        alignment: start;
        VerticalLayout {
            spacing: 2px;
            padding-bottom: 4px;
            Text { text: root.title; font-size: 22px; font-weight: 700; color: Palette.foreground; }
            Text { text: root.subtitle; font-size: 13px; color: Palette.foreground; opacity: 0.65; wrap: word-wrap; }
        }
        @children
    }
}

// Small caps-style heading that groups the navigation entries.
component NavHeading inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Palette.foreground;
    opacity: 0.5;
}

// A thin divider between rows of one card.
component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
    opacity: 0.6;
}

// A button for an action that cannot be undone.
component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 32px;
    min-width: 96px;
    border-radius: 4px;
    background: touch.pressed ? #a82a2a : (touch.has-hover ? #d13d3d : #c42b2b);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text { text: root.text; color: white; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A confirmation drawn over the settings window: dims the page, asks one question.
component ConfirmDialog inherits Rectangle {
    in property <string> heading;
    in property <string> message;
    in property <string> confirm-text;
    in property <bool> danger: true;
    callback confirmed();
    callback dismissed();

    background: #000000a0;
    // Swallow clicks so the page below cannot be used; clicking the dimmed area cancels.
    TouchArea { clicked => { root.dismissed(); } }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.dismissed(); return accept; }
            if (e.text == Key.Return) { root.confirmed(); return accept; }
            reject
        }
        init => { self.focus(); }
    }
    Rectangle {
        width: min(440px, root.width - 48px);
        height: box.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Palette.background;
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000090;
        drop-shadow-offset-y: 8px;
        TouchArea { }
        box := VerticalLayout {
            padding: 24px;
            spacing: 20px;
            HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: root.danger ? #c42b2b30 : Palette.accent-background.with-alpha(0.2);
                    Text {
                        text: root.danger ? "!" : "?";
                        font-size: 22px;
                        font-weight: 700;
                        color: root.danger ? #f0605d : Palette.accent-background;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text { text: root.heading; font-size: 18px; font-weight: 700; color: Palette.foreground; wrap: word-wrap; }
                    Text { text: root.message; font-size: 14px; color: Palette.foreground; opacity: 0.75; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { text: "Cancel"; clicked => { root.dismissed(); } }
                if root.danger: DangerButton { text: root.confirm-text; clicked => { root.confirmed(); } }
                if !root.danger: Button { text: root.confirm-text; primary: true; clicked => { root.confirmed(); } }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "WindowGridRust";
    icon: @image-url("../assets/icon.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 800px;
    min-height: 520px;
    background: Palette.background;

    // navigation and status
    // 0 grid, 1 appearance, 2 behavior, 3 selection HUD, 4 shortcuts, 5 info & usage, 6 under the hood
    in-out property <int> page: 0;
    in-out property <string> status-message;
    in-out property <int> status-kind: 0; // 0 info, 1 success, 2 warning
    in-out property <bool> status-open: false;

    // grid
    in-out property <float> grid-x: 12;
    in-out property <float> grid-y: 6;
    in property <string> screen-summary;
    in property <float> screen-ratio: 1.7778;
    in property <[string]> preset-labels;

    // appearance
    in property <[string]> theme-names;
    in property <[ThemeItem]> themes;
    in-out property <int> theme-index: 0;
    in-out property <float> blur: 3;
    in-out property <float> overlay-opacity: 0.75;
    in-out property <bool> fill-window: true;
    in-out property <bool> radial-gradient: true;
    in-out property <bool> compensate-margins: true;
    in-out property <bool> preserve-size: true;
    in-out property <bool> defer-resize: true;
    in-out property <int> anchor-index: 0;

    // HUD
    in-out property <bool> show-hud: true;
    in-out property <bool> show-dimensions: true;
    in-out property <bool> show-cell-span: true;
    in-out property <bool> show-coverage: true;
    in-out property <bool> show-aspect: true;
    in-out property <bool> show-mode: true;
    in-out property <bool> show-hints: true;

    // shortcuts
    in property <[BindingRow]> bindings;
    in property <[string]> command-names;
    in property <[string]> modifier-names;
    in property <[string]> key-names;

    // system
    in-out property <bool> splash-screen: false;
    in-out property <bool> aero-shake-disabled: false;
    in-out property <bool> drag-full-windows: true;

    // info page
    in property <string> version;
    in property <string> work-dir;
    in property <string> log-file;

    pure callback grid-summary(int, int) -> string;
    pure callback cell-shape(int, int, float) -> string;
    callback save();
    callback reload();
    callback reset();
    callback cancel();
    callback exit-app();
    callback apply-preset(int);
    callback add-binding();
    callback remove-binding(int);
    callback edit-binding(int, string, string);
    callback aero-shake-toggled(bool);
    callback drag-full-windows-toggled(bool);
    callback open-dir();
    callback open-log();

    // which confirmation is showing: 0 none, 1 exit the app, 2 reset the settings
    in-out property <int> confirm: 0;

    property <ThemeItem> theme: root.themes[root.theme-index];
    property <int> gx: Math.round(root.grid-x);
    property <int> gy: Math.round(root.grid-y);

    HorizontalLayout {
        // ---- navigation --------------------------------------------------------------
        Rectangle {
            width: 210px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 14px;
                padding-top: 18px;
                spacing: 3px;
                alignment: start;
                HorizontalLayout {
                    spacing: 10px;
                    padding-left: 4px;
                    padding-bottom: 18px;
                    Image { source: @image-url("../assets/icon.png"); width: 30px; height: 30px; }
                    Text {
                        text: "WindowGridRust";
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
                NavHeading { text: "CONFIGURE"; }
                NavButton { text: "Grid"; selected: root.page == 0; clicked => { root.page = 0; } }
                NavButton { text: "Appearance"; selected: root.page == 1; clicked => { root.page = 1; } }
                NavButton { text: "Behavior"; selected: root.page == 2; clicked => { root.page = 2; } }
                NavButton { text: "Selection HUD"; selected: root.page == 3; clicked => { root.page = 3; } }
                NavButton { text: "Shortcuts"; selected: root.page == 4; clicked => { root.page = 4; } }
                Rectangle { height: 10px; }
                NavHeading { text: "HELP"; }
                NavButton { text: "Info & Usage"; selected: root.page == 5; clicked => { root.page = 5; } }
                NavButton { text: "Under the hood"; selected: root.page == 6; clicked => { root.page = 6; } }
            }
        }

        // ---- content -----------------------------------------------------------------
        VerticalLayout {
            horizontal-stretch: 1;

            if root.status-open: Rectangle {
                height: 40px;
                background: root.status-kind == 1 ? #1e5c2f : (root.status-kind == 2 ? #6b4e0b : #1f4e79);
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text { text: root.status-message; color: white; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; }
                    Rectangle {
                        width: 28px;
                        Text { text: "×"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 18px; }
                        TouchArea { clicked => { root.status-open = false; } }
                    }
                }
            }

            // ---- Grid ------------------------------------------------------------------
            if root.page == 0: Page {
                title: "Grid";
                subtitle: "How the screen is divided. Windows snap to blocks of these cells.";
                Card {
                    title: "Dimensions";
                    HorizontalLayout {
                        spacing: 24px;
                        VerticalLayout {
                            horizontal-stretch: 3;
                            spacing: 10px;
                            alignment: start;
                            GridPreview {
                                cols: root.gx;
                                rows: root.gy;
                                ratio: root.screen-ratio;
                                line: root.theme.line;
                                start: root.theme.start;
                                end: root.theme.end;
                                radial: root.radial-gradient;
                                fill: root.fill-window;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout { alignment: start; Chip { text: root.screen-summary; } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Chip { text: root.grid-summary(root.gx, root.gy); }
                                    Chip { text: root.cell-shape(root.gx, root.gy, root.screen-ratio); }
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 2;
                            min-width: 260px;
                            spacing: 18px;
                            alignment: start;
                            Stepper { label: "Columns"; hint: "Cells across the screen"; minimum: 1; maximum: 32; value <=> root.grid-x; }
                            Stepper { label: "Rows"; hint: "Cells down the screen"; minimum: 1; maximum: 24; value <=> root.grid-y; }
                            Text {
                                text: "Tip: use \u{2212} and + for single steps, the slider for big jumps, or pick a preset below.";
                                color: Palette.foreground;
                                opacity: 0.6;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Card {
                    title: "Presets";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for label[i] in root.preset-labels: Button {
                            width: 72px;
                            text: label;
                            clicked => { root.apply-preset(i); }
                        }
                    }
                }
            }

            // ---- Appearance ------------------------------------------------------------
            if root.page == 1: Page {
                title: "Appearance";
                subtitle: "Colors and look of the grid overlay. The preview updates as you change them.";
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        horizontal-stretch: 3;
                        title: "Overlay";
                        SettingRow {
                            label: "Color theme";
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { width: 16px; height: 16px; y: 6px; border-radius: 3px; background: root.theme.line; }
                                Rectangle { width: 16px; height: 16px; y: 6px; border-radius: 3px; background: root.theme.start; }
                                Rectangle { width: 16px; height: 16px; y: 6px; border-radius: 3px; background: root.theme.end; }
                                ComboBox {
                                    width: 150px;
                                    model: root.theme-names;
                                    current-index <=> root.theme-index;
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: "Overlay opacity";
                            HorizontalLayout {
                                spacing: 10px;
                                Slider { width: 150px; minimum: 0.05; maximum: 1; value: root.overlay-opacity; changed(v) => { root.overlay-opacity = v; } }
                                Text { text: Math.round(root.overlay-opacity * 100) + "%"; color: Palette.foreground; width: 38px; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: "Shadow blur";
                            hint: "0 turns the shadow off.";
                            HorizontalLayout {
                                spacing: 10px;
                                Slider { width: 150px; minimum: 0; maximum: 50; value: root.blur; changed(v) => { root.blur = v; } }
                                Text { text: Math.round(root.blur); color: Palette.foreground; width: 38px; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                        Divider { }
                        SettingRow { label: "Fill the selection"; hint: "Off draws only an outline."; Switch { checked <=> root.fill-window; } }
                        Divider { }
                        SettingRow { label: "Radial gradient"; Switch { checked <=> root.radial-gradient; } }
                    }
                    Card {
                        horizontal-stretch: 2;
                        min-width: 320px;
                        title: "Preview";
                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;
                            GridPreview {
                                cols: root.gx;
                                rows: root.gy;
                                ratio: root.screen-ratio;
                                line: root.theme.line;
                                start: root.theme.start;
                                end: root.theme.end;
                                radial: root.radial-gradient;
                                fill: root.fill-window;
                                opacity: 0.25 + 0.75 * root.overlay-opacity;
                            }
                            Text { text: root.grid-summary(root.gx, root.gy); color: Palette.foreground; opacity: 0.65; font-size: 12px; }
                        }
                    }
                }
            }

            // ---- Behavior --------------------------------------------------------------
            if root.page == 2: Page {
                title: "Behavior";
                subtitle: "How windows are placed, and the Windows options WindowGridRust depends on.";
                Card {
                    title: "Snapping";
                    SettingRow {
                        label: "Window anchor";
                        hint: "Where a window that is larger than the selection extends.";
                        ComboBox { width: 150px; model: ["TopLeft", "Center", "GrabPoint"]; current-index <=> root.anchor-index; }
                    }
                    Divider { }
                    SettingRow { label: "Compensate window margins"; hint: "Align the visible window edge, not the invisible resize border."; Switch { checked <=> root.compensate-margins; } }
                    Divider { }
                    SettingRow { label: "Preserve size on move"; hint: "A moved window keeps its size instead of stretching to the cells."; Switch { checked <=> root.preserve-size; } }
                    Divider { }
                    SettingRow { label: "Defer resize until release"; hint: "Resize once when you let go, instead of live while dragging."; Switch { checked <=> root.defer-resize; } }
                }
                Card {
                    title: "System & application";
                    SettingRow { label: "Show splash screen at start"; Switch { checked <=> root.splash-screen; } }
                    Divider { }
                    SettingRow {
                        label: "Disable Windows Aero Shake";
                        hint: "Applies immediately.";
                        Switch { checked: root.aero-shake-disabled; toggled => { root.aero-shake-toggled(self.checked); } }
                    }
                    Divider { }
                    SettingRow {
                        label: "Show window contents while dragging";
                        hint: "Applies immediately. Needed for live resizing.";
                        Switch { checked: root.drag-full-windows; toggled => { root.drag-full-windows-toggled(self.checked); } }
                    }
                }
            }

            // ---- Selection HUD ---------------------------------------------------------
            if root.page == 3: Page {
                title: "Selection HUD";
                subtitle: "The small readout shown next to the selection while you drag.";
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        horizontal-stretch: 1;
                        title: "Readout";
                        SettingRow { label: "Enable selection HUD"; Switch { checked <=> root.show-hud; } }
                        Divider { }
                        SettingRow { label: "Pixel dimensions"; dim: !root.show-hud; Switch { enabled: root.show-hud; checked <=> root.show-dimensions; } }
                        SettingRow { label: "Grid cell span"; dim: !root.show-hud; Switch { enabled: root.show-hud; checked <=> root.show-cell-span; } }
                        SettingRow { label: "Screen coverage"; dim: !root.show-hud; Switch { enabled: root.show-hud; checked <=> root.show-coverage; } }
                        SettingRow { label: "Window aspect ratio"; dim: !root.show-hud; Switch { enabled: root.show-hud; checked <=> root.show-aspect; } }
                    }
                    Card {
                        horizontal-stretch: 1;
                        title: "Extras";
                        SettingRow { label: "Mode indicator badge"; hint: "Shows whether you are resizing or moving."; Switch { checked <=> root.show-mode; } }
                        Divider { }
                        SettingRow { label: "Interaction and key hints"; hint: "A hint bar with the keys that apply right now."; Switch { checked <=> root.show-hints; } }
                    }
                }
            }

            // ---- Shortcuts -------------------------------------------------------------
            if root.page == 4: Page {
                title: "Shortcuts";
                subtitle: "Each row starts a command while you drag a window: a modifier or a key.";
                Card {
                    title: "Input shortcuts";
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Command"; width: 120px; color: Palette.foreground; opacity: 0.6; font-size: 12px; }
                        Text { text: "Modifier"; width: 120px; color: Palette.foreground; opacity: 0.6; font-size: 12px; }
                        Text { text: "Key"; horizontal-stretch: 1; color: Palette.foreground; opacity: 0.6; font-size: 12px; }
                        Rectangle { width: 40px; }
                    }
                    for row[i] in root.bindings: HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            width: 120px;
                            model: root.command-names;
                            current-value: row.command;
                            selected(v) => { root.edit-binding(i, "command", v); }
                        }
                        ComboBox {
                            width: 120px;
                            model: root.modifier-names;
                            current-value: row.modifier;
                            selected(v) => { root.edit-binding(i, "modifier", v); }
                        }
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.key-names;
                            current-value: row.key;
                            selected(v) => { root.edit-binding(i, "key", v); }
                        }
                        Button { text: "×"; width: 40px; clicked => { root.remove-binding(i); } }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: "Add shortcut"; clicked => { root.add-binding(); } }
                    }
                }
            }

            // ---- Info & Usage ----------------------------------------------------------
            if root.page == 5: Page {
                title: "Info & Usage";
                subtitle: "How to use WindowGridRust, and where its files live.";
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        horizontal-stretch: 1;
                        title: "Resize a window";
                        Text { text: "1. Hold the left mouse button and drag a window by its title bar."; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "2. Press and hold your Resize shortcut (for example Space or the right mouse button)."; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "3. Move the pointer to the first cell, release the shortcut, move to the opposite cell and release the mouse button."; color: Palette.foreground; wrap: word-wrap; }
                    }
                    Card {
                        horizontal-stretch: 1;
                        title: "Move a window";
                        Text { text: "1. Hold the left mouse button and drag a window by its title bar."; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "2. Press your Move shortcut (for example Left Ctrl or the middle mouse button)."; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "3. Release the mouse button: the window snaps onto the cells, keeping its size. Esc cancels."; color: Palette.foreground; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        horizontal-stretch: 1;
                        title: "Diagnostic paths";
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Working directory"; color: Palette.foreground; opacity: 0.7; font-size: 12px; }
                            Text { text: root.work-dir; color: Palette.foreground; wrap: word-wrap; }
                            HorizontalLayout { alignment: start; Button { text: "Open folder"; clicked => { root.open-dir(); } } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Log file"; color: Palette.foreground; opacity: 0.7; font-size: 12px; }
                            Text { text: root.log-file; color: Palette.foreground; wrap: word-wrap; }
                            HorizontalLayout { alignment: start; Button { text: "Open log"; clicked => { root.open-log(); } } }
                        }
                    }
                    Card {
                        horizontal-stretch: 1;
                        title: "About WindowGridRust";
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Version"; color: Palette.foreground; opacity: 0.7; width: 70px; }
                            Text { text: root.version; color: Palette.foreground; }
                        }
                        Rectangle { height: 110px; AboutSlint { } }
                    }
                }
            }

            // ---- Under the hood --------------------------------------------------------
            if root.page == 6: Page {
                title: "Under the hood";
                subtitle: "WindowGridRust reimplements the original WindowGrid in Rust. What changed, and how the pieces work together.";
                Card {
                    title: "Original C# WindowGrid vs. WindowGridRust";
                    GridLayout {
                        spacing-horizontal: 16px;
                        spacing-vertical: 5px;
                        Row {
                            Text { text: ""; color: Palette.foreground; font-size: 13px; }
                            Text { text: "C# / .NET"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "Rust"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                        Row {
                            Text { text: "App executable"; color: Palette.foreground; font-size: 13px; }
                            Text { text: "141 MB"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "10.5 MB (includes overlay and hooks)"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                        Row {
                            Text { text: "App memory, idle"; color: Palette.foreground; font-size: 13px; }
                            Text { text: "245 MB"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "27 MB"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                        Row {
                            Text { text: "Overlay executable"; color: Palette.foreground; font-size: 13px; }
                            Text { text: "71 MB"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "447 KB"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                        Row {
                            Text { text: "Overlay memory, idle"; color: Palette.foreground; font-size: 13px; }
                            Text { text: "213 MB"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "9 MB"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                        Row {
                            Text { text: "Hook DLLs"; color: Palette.foreground; font-size: 13px; }
                            Text { text: "2016 binaries, no source"; color: Palette.foreground; opacity: 0.6; font-size: 13px; }
                            Text { text: "17\u{2013}20 KB each, Rust source"; color: Palette.foreground; font-size: 13px; font-weight: 700; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        horizontal-stretch: 1;
                        title: "How a drag works";
                        Fact {
                            title: "Hook DLLs, one per bitness";
                            body: "Started through rundll32. A WinEvent hook is loaded into the process whose window you drag, and watches your shortcuts and the mouse for that one drag. No C runtime, so they are tiny.";
                        }
                        Fact {
                            title: "Overlay";
                            body: "A click-through window drawn on the GPU (DirectComposition, Direct2D), visible only while you drag. It also computes the final snap, including the invisible window borders.";
                        }
                        Fact {
                            title: "Talking to each other";
                            body: "Shared memory carries the settings; four registered window messages signal target, show, area and stop.";
                        }
                    }
                    Card {
                        horizontal-stretch: 1;
                        title: "This app";
                        Fact {
                            title: "One executable";
                            body: "Carries the overlay and hooks and unpacks them next to itself. The windows use Slint (software renderer): no GPU or web runtime needed.";
                        }
                        Fact {
                            title: "Supervisor";
                            body: "Runs the overlay and hook hosts in a job object: they end with the app, and a crashed one restarts, up to a crash-loop limit. It never touches other programs' rundll32.";
                        }
                    }
                }
                Text {
                    text: "Built for x64, x86 and ARM64. Only the x64 hook is drag-tested; the ARM64 one builds but has never run on real hardware. Settings use the same format as the original WindowGrid.settings. Details: docs/adr 000\u{2013}005.";
                    color: Palette.foreground;
                    opacity: 0.55;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // ---- bottom bar ------------------------------------------------------------
            Rectangle {
                height: 56px;
                background: Palette.alternate-background;
                Rectangle { y: 0px; height: 1px; background: Palette.border; }
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 8px;
                    Button { text: "Exit app"; clicked => { root.confirm = 1; } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Reset defaults"; clicked => { root.confirm = 2; } }
                    Button { text: "Reload"; clicked => { root.reload(); } }
                    Button { text: "Cancel"; clicked => { root.cancel(); } }
                    Button { text: "Save changes"; primary: true; clicked => { root.save(); } }
                }
            }
        }
    }
    if root.confirm != 0: ConfirmDialog {
        width: root.width;
        height: root.height;
        heading: root.confirm == 1 ? "Exit WindowGridRust?" : "Reset all settings?";
        message: root.confirm == 1
            ? "WindowGridRust will close completely. Windows will no longer snap to the grid until you start it again."
            : "Every setting goes back to its default value, including your shortcuts. This cannot be undone.";
        confirm-text: root.confirm == 1 ? "Exit WindowGridRust" : "Reset settings";
        confirmed => {
            if (root.confirm == 1) { root.exit-app(); } else { root.reset(); }
            root.confirm = 0;
        }
        dismissed => { root.confirm = 0; }
    }
}

// ---------------------------------------------------------------------------------------
// Install dialog
// ---------------------------------------------------------------------------------------

export component InstallWindow inherits Window {
    title: "WindowGridRust Setup";
    icon: @image-url("../assets/icon.png");
    preferred-width: 520px;
    preferred-height: 400px;
    min-width: 520px;
    max-width: 520px;
    min-height: 400px;
    max-height: 400px;
    background: Palette.background;

    in-out property <string> path;
    in-out property <bool> portable: false;
    in-out property <bool> shortcut: true;
    in-out property <bool> autostart: true;
    in-out property <bool> splash-screen: false;
    in property <bool> needs-admin: false;
    in property <string> version;

    callback browse();
    callback use-default();
    callback accept();
    callback cancel();
    callback path-edited(string);

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        Text { text: "Set up WindowGridRust " + root.version; font-size: 20px; font-weight: 700; color: Palette.foreground; }

        HorizontalLayout {
            spacing: 8px;
            Button { text: "Install"; primary: !root.portable; clicked => { root.portable = false; root.use-default(); } }
            Button { text: "Portable"; primary: root.portable; clicked => { root.portable = true; root.use-default(); } }
        }

        VerticalLayout {
            spacing: 6px;
            Text { text: root.portable ? "Run from this folder" : "Install into"; color: Palette.foreground; opacity: 0.7; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.path;
                    edited(t) => { root.path-edited(t); }
                    horizontal-stretch: 1;
                }
                Button { text: "Browse\u{2026}"; clicked => { root.browse(); } }
                Button { text: "Default"; clicked => { root.use-default(); } }
            }
            if root.needs-admin && !root.portable: Text {
                text: "\u{26A0} Administrator permission is needed for this folder.";
                color: #e6a700;
                font-size: 12px;
            }
        }

        VerticalLayout {
            spacing: 4px;
            Switch { text: "Create a Start Menu shortcut"; enabled: !root.portable; checked <=> root.shortcut; }
            Switch { text: "Start WindowGridRust when I sign in"; enabled: !root.portable; checked <=> root.autostart; }
            Switch { text: "Show a splash screen at start"; checked <=> root.splash-screen; }
        }

        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button { text: "Cancel"; clicked => { root.cancel(); } }
            Button { text: root.portable ? "Start" : "Install"; primary: true; clicked => { root.accept(); } }
        }
    }
}

// ---------------------------------------------------------------------------------------
// Splash screen
// ---------------------------------------------------------------------------------------

export component SplashWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 256px;
    preferred-height: 256px;
    Image { source: @image-url("../assets/icon.png"); width: 256px; height: 256px; }
}
